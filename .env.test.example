PROJECT_NAME="Movie theater"
PROJECT_DESCRIPTION="The best movie theater for everyone"

DEBUG=True
SECRET_KEY=django_secret_key

FASTAPI_HOST=fastapi
FASTAPI_PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=theatre
POSTGRES_HOST=theatre-db
POSTGRES_PORT=5432
POSTGRES_OPTIONS=-c search_path=public,schema
POSTGRES_ASYNC_DRIVER=postgresql+asyncpg

ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_SCHEMA='http://'

REDIS_HOST=redis
REDIS_PORT=6379

AUTH_HOST=authapi
AUTH_PORT=8000

AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432


FASTAPI_HOST=fastapi
FASTAPI_PORT=8000

AUTH_SERVICE_HOST=authapi
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_AUTHENTICATE_TOKEN_ENDPOINT=/users/authenticate_token

AUTH_DB_SUPERUSER_PASSWORD=SUPERUSER_PASSWORD